              one model's floor here would stop this widget serving any other
              DosingPump server. -->
         <widget class="QDoubleSpinBox" name="volume_spin">
          <property name="minimum"><double>0.010</double></property>
          <property name="maximum"><double>10000.000</double></property>
          <property name="value"><double>10.000</double></property>
          <property name="decimals"><number>2</number></property>
          <property name="singleStep"><double>0.50</double></property>
