<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1280</width><height>820</height></rect>
  </property>
  <property name="minimumSize">
   <size><width>1024</width><height>700</height></size>
  </property>
  <property name="windowTitle">
   <string>Rxn Bench</string>
  </property>

  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="central_layout">
    <property name="spacing"><number>0</number></property>
    <property name="leftMargin"><number>0</number></property>
    <property name="topMargin"><number>0</number></property>
    <property name="rightMargin"><number>0</number></property>
    <property name="bottomMargin"><number>0</number></property>

    <item>
     <widget class="QTabWidget" name="main_tabs">
      <property name="currentIndex"><number>0</number></property>
      <property name="tabPosition"><enum>QTabWidget::North</enum></property>
      <property name="documentMode"><bool>false</bool></property>

      <!-- ── Workspace tab ── -->
      <widget class="QWidget" name="workspace_page">
       <attribute name="title"><string>Workspace</string></attribute>
       <layout class="QVBoxLayout" name="workspace_layout">
        <property name="spacing"><number>0</number></property>
        <property name="leftMargin"><number>0</number></property>
        <property name="topMargin"><number>0</number></property>
        <property name="rightMargin"><number>0</number></property>
        <property name="bottomMargin"><number>0</number></property>

        <!--
          workspace_stack switches between two pages:
            page_empty   (index 0) — shown when no devices are connected
            page_devices (index 1) — shown once at least one device is added
          Python switches pages and manages device_tabs.
        -->
        <item>
         <widget class="QStackedWidget" name="workspace_stack">
          <property name="currentIndex"><number>0</number></property>

          <!-- Empty state -->
          <widget class="QWidget" name="page_empty">
           <layout class="QVBoxLayout" name="empty_layout">
            <property name="spacing"><number>8</number></property>

            <item>
             <spacer name="empty_top">
              <property name="orientation"><enum>Qt::Vertical</enum></property>
              <property name="sizeHint" stdset="0">
               <size><width>20</width><height>80</height></size>
              </property>
             </spacer>
            </item>

            <item>
             <widget class="QLabel" name="empty_title_lbl">
              <property name="text"><string>No devices connected.</string></property>
              <property name="alignment">
               <set>Qt::AlignmentFlag::AlignHCenter|Qt::AlignmentFlag::AlignVCenter</set>
              </property>
              <property name="font">
               <font><pointsize>14</pointsize><bold>true</bold></font>
              </property>
             </widget>
            </item>

            <item>
             <widget class="QLabel" name="empty_hint_lbl">
              <property name="text"><string>Open the Add Device tab to discover and connect to SiLA servers on your network.</string></property>
              <property name="alignment">
               <set>Qt::AlignmentFlag::AlignHCenter|Qt::AlignmentFlag::AlignVCenter</set>
              </property>
              <property name="wordWrap"><bool>true</bool></property>
             </widget>
            </item>

            <item>
             <spacer name="empty_bottom">
              <property name="orientation"><enum>Qt::Vertical</enum></property>
              <property name="sizeHint" stdset="0">
               <size><width>20</width><height>80</height></size>
              </property>
             </spacer>
            </item>

           </layout>
          </widget>

          <!-- Device panels -->
          <widget class="QWidget" name="page_devices">
           <layout class="QVBoxLayout" name="devices_layout">
            <property name="spacing"><number>0</number></property>
            <property name="leftMargin"><number>0</number></property>
            <property name="topMargin"><number>0</number></property>
            <property name="rightMargin"><number>0</number></property>
            <property name="bottomMargin"><number>0</number></property>

            <!--
              device_tabs holds one tab per connected device.
              Each tab is a QScrollArea wrapping the device's widget panel —
              so panels of any size work without breaking the layout.
              Python adds/removes tabs. tabsClosable lets the user disconnect.
            -->
            <item>
             <widget class="QTabWidget" name="device_tabs">
              <property name="tabsClosable"><bool>true</bool></property>
              <property name="movable"><bool>true</bool></property>
              <property name="documentMode"><bool>true</bool></property>
             </widget>
            </item>

           </layout>
          </widget>

         </widget>
        </item>

       </layout>
      </widget>

      <!-- ── Add Device tab ── -->
      <widget class="QWidget" name="add_device_page">
       <attribute name="title"><string>+ Add Device</string></attribute>
       <layout class="QVBoxLayout" name="add_device_layout">
        <property name="spacing"><number>0</number></property>
        <property name="leftMargin"><number>0</number></property>
        <property name="topMargin"><number>0</number></property>
        <property name="rightMargin"><number>0</number></property>
        <property name="bottomMargin"><number>0</number></property>

        <!--
          Python instantiates ServerBrowserDialog(parent=self) and adds it
          here via add_device_layout.addWidget(browser). The browser emits
          device_requested(DiscoveredServer) which the main window catches to
          create the device panel and switch to the Workspace tab.
        -->

       </layout>
      </widget>

     </widget>
    </item>

   </layout>
  </widget>

  <widget class="QMenuBar" name="menubar">
   <property name="geometry">
    <rect><x>0</x><y>0</y><width>1280</width><height>24</height></rect>
   </property>
   <widget class="QMenu" name="menu_file">
    <property name="title"><string>File</string></property>
    <addaction name="action_quit"/>
   </widget>
   <addaction name="menu_file"/>
  </widget>

  <widget class="QStatusBar" name="statusbar"/>

  <action name="action_quit">
   <property name="text"><string>Quit</string></property>
   <property name="shortcut"><string>Ctrl+Q</string></property>
  </action>

 </widget>
