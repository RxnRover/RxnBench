   <property name="rightMargin"><number>16</number></property>
   <property name="bottomMargin"><number>16</number></property>

   <item>
    <widget class="QStackedWidget" name="page_stack">

     <!-- ── Page 0: Intro ── -->
     <widget class="QWidget" name="page_intro">
      <layout class="QVBoxLayout" name="intro_layout">
       <property name="spacing"><number>12</number></property>
       <item>
        <widget class="QLabel" name="intro_title">
         <property name="text"><string>Toolhead Offset Calibration</string></property>
         <property name="font"><font><pointsize>14</pointsize><bold>true</bold></font></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="toolhead_name_lbl">
         <property name="text"><string>Calibrating: —</string></property>
         <property name="font"><font><bold>true</bold></font></property>
