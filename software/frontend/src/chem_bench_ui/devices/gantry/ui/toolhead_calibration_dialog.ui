       <!-- Jog controls -->
       <item>
        <widget class="QGroupBox" name="jog_group">
         <property name="title"><string>Jog</string></property>
         <layout class="QHBoxLayout" name="jog_outer">
          <property name="spacing"><number>20</number></property>
          <item>
           <layout class="QGridLayout" name="xy_jog_grid">
