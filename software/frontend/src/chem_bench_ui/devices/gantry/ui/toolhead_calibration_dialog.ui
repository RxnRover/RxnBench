       </item>
       <item>
        <widget class="QLabel" name="cal_ref_well_lbl">
         <property name="text"><string>Reference well: —</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="intro_body">
         <property name="text"><string>Move the gantry to the nominal reference well position, then jog the tip to 4 rim points (NW → NE → SE → SW) to find the true centre. The average of those 4 points is saved as the tip offset.</string></property>
         <property name="wordWrap"><bool>true</bool></property>
        </widget>
       </item>
       <item>
        <spacer>
         <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
        </spacer>
       </item>
       <item>
        <layout class="QHBoxLayout">
         <item>
          <spacer>
           <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
           <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
          </spacer>
         </item>
         <item>
          <widget class="QPushButton" name="start_cal_btn">
           <property name="text"><string>Start Calibration →</string></property>
           <property name="minimumWidth"><number>140</number></property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>

     <!-- ── Page 1: Corner sequence ── -->
     <widget class="QWidget" name="page_corners">
      <layout class="QVBoxLayout" name="corners_layout">
       <property name="spacing"><number>8</number></property>

       <item>
        <widget class="QLabel" name="corner_title_lbl">
         <property name="text"><string>Point 1 of 4 — NW rim</string></property>
         <property name="font"><font><pointsize>13</pointsize><bold>true</bold></font></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="corner_instruction_lbl">
         <property name="text"><string>Jog the tip to the North West rim of the reference well, then confirm.</string></property>
         <property name="wordWrap"><bool>true</bool></property>
        </widget>
       </item>

       <!-- Diagram + progress side by side -->
       <item>
        <layout class="QHBoxLayout">
         <property name="spacing"><number>16</number></property>
         <item>
          <widget class="QLabel" name="corner_diagram_lbl">
           <property name="minimumSize"><size><width>200</width><height>200</height></size></property>
           <property name="maximumSize"><size><width>200</width><height>200</height></size></property>
           <property name="frameShape"><enum>QFrame::Shape::NoFrame</enum></property>
